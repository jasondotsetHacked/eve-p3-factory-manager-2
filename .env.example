# Optional local values for Node-based ESI exploration tests.
# Do not commit real access tokens.
EVE_ACCESS_TOKEN=
EVE_CHARACTER_ID=
EVE_PLANET_ID=
EVE_USER_AGENT=PIFactoryManager/0.1.0 (contact@example.com; +https://github.com/your-name/pi-factory-manager)

# Public browser client id from the EVE developer portal.
# This is safe to expose in a static frontend; never expose a client secret.
EVE_CLIENT_ID=
EVE_REDIRECT_URI=http://127.0.0.1:4173/
